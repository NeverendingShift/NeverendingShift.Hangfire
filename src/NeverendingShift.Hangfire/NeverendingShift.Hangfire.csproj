<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeting: .NET Framework 4.6.2, .NET Standard 2.0, and .NET 8 -->
    <TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>

    <!-- Language version -->
    <LangVersion>latest</LangVersion>

    <!-- NuGet metadata -->
    <PackageId>NeverendingShift.Hangfire</PackageId>
    <Version>1.0.0</Version>
    <Authors>Daniel Barwikowski</Authors>
    <Company>NeverendingShift</Company>
    <Description>
      Advanced Hangfire extensions including thread-safe PerformingContext accessor,
      and enterprise-ready filters.
      Compatible with .NET Framework 4.6.2, .NET Standard 2.0, and .NET 8+.
    </Description>
    <PackageTags>hangfire;jobcontext;performingcontext;filters;background-jobs;netframework;netcore</PackageTags>
    <PackageProjectUrl>https://github.com/NeverendingShift/NeverendingShift.Hangfire</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NeverendingShift/NeverendingShift.Hangfire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build settings -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Suppress warnings for missing XML comments if needed -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Include README in package -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Common dependencies for all frameworks -->
  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="[1.7.0,2.0.0)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Dependencies specific to .NET Standard 2.0 and .NET 8 (for DI support) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="2.1.0" />
  </ItemGroup>

</Project>